/****** Object:  Step [Sgntm1_Replication_Error_Msg]    Script Date: 1/15/2025 4:10:21 PM ******/
EXEC @ReturnCode = msdb.dbo.sp_add_jobstep @job_id=@jobId, @step_name=N'Sgntm1_Replication_Error_Msg', 
		@step_id=4, 
