publisher
,publisher_db
,publication
,alert_error_text
,alert_error_code
,article
,subscriber
,subscriber_db
,time
FROM [msdb].[dbo].sysreplicationalerts WHERE time >= DATEADD(MINUTE, -15, GETDATE())
--ORDER BY time DESC
go', 
